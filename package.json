{
  "name": "audit-evidence-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx scripts/gen-data.ts",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx scripts/evaluate.ts",
    "check": "npm run test && npm run build && npm run eval",
    "smoke": "tsx scripts/smoke-test.ts",
    "live:preflight": "tsx scripts/live-preflight.ts",
    "samples:live": "tsx scripts/build-live-samples.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@meta-sam/parser": "0.1.0",
    "@napi-rs/canvas": "1.0.13",
    "archiver": "8.0.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "lucide-react": "1.63.0",
    "multer": "2.5.0",
    "openai": "7.45.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "description": "Pixel-backed audit evidence, deterministic vouching and independent Meta model verification.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
